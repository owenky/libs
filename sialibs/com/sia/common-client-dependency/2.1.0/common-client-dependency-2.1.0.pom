<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>sialibs.com.sia</groupId>
	<artifactId>common-client-dependency</artifactId>
	<version>1.2.5</version>
	<name>common-client-dependency</name>
	<packaging>pom</packaging>
	<description>Common dependency of client applications</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>1.8</java.version>
		<maven.compiler.target>1.8</maven.compiler.target>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.jar.plugin.version>3.2.0</maven.jar.plugin.version>
		<!-- following to skip unit test when running " mvn clean package" -->
		<maven.test.skip>true</maven.test.skip>
		<!-- following used for jar singing with old local jks. It is replaced by Digicert KeyLocker on 04/13/2024-->
<!--		<key.store.path>${user.dir}/DigitCertAndJarSign/</key.store.path>-->
<!--		<key.store.name>sia.jks</key.store.name>-->
<!--		<store.password>sia04032021</store.password>-->
<!--		<key.password>sia04032021</key.password>-->
<!--		<key.alias>sia</key.alias>-->
<!--		<key.store>${key.store.path}${key.store.name}</key.store>-->
        <!-- following used for jar singing with Digicert KeyLocker on 04/13/2024-->
            <key.store>NONE</key.store>
            <store.password>NONE</store.password>
            <provider.class>sun.security.pkcs11.SunPKCS11</provider.class>
            <store.type>PKCS11</store.type>
            <!-- see README.md for how to create pkcs11properties.cfg-->
            <provider.arg>C:\Program Files\DigiCert\DigiCert Keylocker Tools\pkcs11properties.cfg</provider.arg>
            <key.alias>key_713216849</key.alias>
            <tsa>http://timestamp.digicert.com</tsa>
        <!-- end of singing with Digicert KeyLocker on 04/13/2024-->
	</properties>
